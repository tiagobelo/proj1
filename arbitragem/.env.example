DATABASE_URL=postgresql://arbitragem:arbitragem@localhost:5432/arbitragem

# Quantas páginas (~50 produtos cada) coletar por categoria a cada execução
MAX_PAGES_PER_CATEGORY=2

# Intervalo em segundos entre requisições de página, para reduzir risco de bloqueio
REQUEST_DELAY_SECONDS=3

# false para abrir o navegador visível durante o desenvolvimento/depuração
HEADLESS=true
